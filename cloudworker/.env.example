NODE_ENV=development

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=change-me
DATABASE_NAME=reviewmonitor
DATABASE_TIMEZONE=+00:00
DATABASE_POOL_SIZE=3

# 必须与 API 使用同一密钥，否则无法解密市场凭证
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=1

WORKER_LOCK_SECONDS=300
WORKER_TIME_BUDGET_MS=200000
SYNC_PAGE_SIZE=50
SYNC_MAX_PAGES=20
SYNC_OVERLAP_MINUTES=30
SCHEDULER_BATCH_SIZE=50
WORKER_BATCH_SIZE=5
RETRY_BASE_SECONDS=60
RETRY_MAX_SECONDS=3600
TASK_RETENTION_DAYS=30

# 函数计算异步触发地址（留空则就地执行）
WORKER_TRIGGER_URL=
NOTIFICATION_TRIGGER_URL=
INTERNAL_TRIGGER_SECRET=

# 仅本地联调：允许 webhook 指向内网地址（默认 false，生产保持 false）
ALLOW_PRIVATE_WEBHOOKS=false

NODE_ENV=development
API_PORT=3060
WEB_ORIGIN=http://localhost:5160
DASH_ORIGIN=http://localhost:5161

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=reviewmonitor
# Must match the MySQL server session timezone. Use +00:00 when the server runs in UTC.
DATABASE_TIMEZONE=+00:00

JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_ADMIN_SECRET=replace-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-bytes
CREDENTIAL_KEY_VERSION=1

STORE_MOCK_ENABLED=true
TELEGRAM_API_BASE=https://api.telegram.org

ADMIN_EMAIL=admin@reviewmonitor.local
ADMIN_PASSWORD=replace-me
